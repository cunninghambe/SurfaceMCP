# SurfaceMCP — role credentials
# Copy to .env.local and fill in the actual values.
# .env.local is gitignored; surfacemcp.config.json is not.

# Example: referenced in config as "$env:OWNER_PASSWORD"
# OWNER_PASSWORD=supersecret

# OAuth2 client-credentials roles (auth.kind: "oauth2").
# Referenced in config as "$env:API_CLIENT_ID" / "$env:API_CLIENT_SECRET".
# API_CLIENT_ID=
# API_CLIENT_SECRET=

# Log level: trace | debug | info | warn | error
# LOG_LEVEL=info
